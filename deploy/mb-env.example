# Template for ~/.mb-env on the server: the tick's database settings, read by
# mb/tick.sh. Server-owned and never deployed.
#
# Install:  scp deploy/mb-env.example siteground-mb:.mb-env
#           ssh siteground-mb 'chmod 600 ~/.mb-env'
# then edit the values to match public_html/.htaccess.
MB_DB_HOST=localhost
MB_DB_NAME=CHANGEME_database
MB_DB_USER=CHANGEME_user
MB_DB_PASS=CHANGEME_password
MB_REPORT_QUERIES=1

# As in public_html/.htaccess: the tick mails players whose kingdom it deletes,
# with a link back to the site.
MB_SITE_URL=https://jacobp259.sg-host.com
MB_MAIL_FROM=noreply@jacobp259.sg-host.com

# Whether the tick sends those mails. It used to mail a hardcoded address on
# every run as well, which is gone.
MB_TICK_MAIL=1
